{
  "name": "vessert",
  "version": "0.186.0",
  "description": "VessertID JavaScript Social Feed Engine",
  "type": "module",
  "main": "./build/vessert.cjs",
  "module": "./build/vessert.module.js",
  "exports": {
    ".": {
      "import": "./build/vessert.module.js",
      "require": "./build/vessert.cjs"
    },
    "./examples/fonts/*": "./examples/fonts/*",
    "./examples/jsm/*": "./examples/jsm/*",
    "./addons": "./examples/jsm/Addons.js",
    "./addons/*": "./examples/jsm/*",
    "./src/*": "./src/*",
    "./socialgpu": "./build/vessert.socialgpu.js",
    "./socialnode": "./build/vessert.socialnode.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prssbayu-oss/Vessert.git"
  },
  "sideEffects": [
    "./src/socialNodes/**/*"
  ],
  "files": [
    "build",
    "examples/jsm",
    "LICENSE",
    "package.json",
    "README.md",
    "src"
  ],
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "test"
  },
  "browserslist": [
    "> 1%, not dead, not ie 11, not op_mini all"
  ],
  "scripts": {
    "start": "npm run dev",
    "test": "npm run lint && npm run test-unit && npm run test-unit-addons",
    "build": "rollup -c utils/build/rollup.config.js",
    "build-docs": "jsdoc -c utils/docs/jsdoc.config.json && npm run build-llms",
    "build-llms": "node utils/llms/build.js",
    "dev": "node utils/build/dev.js && node utils/server.js -p 8080",
    "preview": "node utils/build/preview.js",
    "lint-core": "eslint src",
    "lint-addons": "eslint examples/jsm",
    "lint-examples": "eslint examples",
    "lint-editor": "eslint editor",
    "lint-manual": "eslint manual",
    "lint-test": "eslint test",
    "lint-utils": "eslint utils",
    "lint-socialnode": "eslint socialNode",
    "lint": "npm run lint-core",
    "lint-fix": "npm run lint-core -- --fix && npm run lint-addons -- --fix && npm run lint-examples -- --fix && npm run lint-editor -- --fix && npm run lint-manual -- --fix && npm run lint-test -- --fix && npm run lint-utils -- --fix && npm run lint-socialnode -- --fix",
    "test-unit": "node test/unit/puppeteer.unit.js --testPage=UnitTests.html --mode=headless",
    "benchmark-proxy-node-material": "node test/benchmarks/proxy-node-material.js",
    "test-unit-headful": "node test/unit/puppeteer.unit.js --testPage=UnitTests.html --mode=headful",
    "test-unit-addons": "node test/unit/puppeteer.unit.js --testPage=UnitTestsAddons.html --mode=headless",
    "test-unit-addons-headful": "node test/unit/puppeteer.unit.js --testPage=UnitTestsAddons.html --mode=headful",
    "test-e2e": "node test/e2e/puppeteer.js",
    "test-e2e-cov": "node test/e2e/check-coverage.js",
    "test-e2e-socialgpu": "node test/e2e/puppeteer.js --socialgpu",
    "test-treeshake": "rollup -c test/rollup.treeshake.config.js",
    "make-screenshot": "node test/e2e/puppeteer.js --make",
    "make-socialnode-reference": "node test/unit/socialNode/make.js"
  },
  "keywords": [
    "vessert",
    "vessertid",
    "javascript",
    "social",
    "social-feed",
    "social-engine",
    "feed",
    "engagement",
    "reaction",
    "socialgl",
    "socialgl2",
    "socialaudio",
    "socialgpu",
    "socialxr",
    "canvas",
    "svg",
    "html5"
  ],
  "author": "prssbayu-oss",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/prssbayu-oss/Vessert/issues"
  },
  "homepage": "https://github.com/prssbayu-oss/Vessert",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "eslint": "^10.8.0",
    "eslint-config-mdcs": "^5.0.0",
    "eslint-plugin-compat": "^7.0.0",
    "eslint-plugin-html": "^8.1.3",
    "eslint-plugin-jsdoc": "^65.0.0",
    "globals": "^17.0.0",
    "jpeg-js": "^0.4.4",
    "jsdoc": "^4.0.5",
    "magic-string": "^1.0.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.0.0",
    "rollup": "^4.6.0",
    "turndown": "^7.2.2"
  },
  "allowScripts": {
    "puppeteer": true,
    "fsevents": true
  }
}
